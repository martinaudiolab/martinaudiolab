# Response headers for Cloudflare (this file is not served to visitors). A request matching several rules gets
# all of their headers; "! Name" drops a header that a broader rule set.

# ---- Security, every response ---------------------------------------------------------------------------------
# - nosniff: a file is only ever treated as the type it is served as (an uploaded picture can never run as a page)
# - no framing (frame-ancestors / X-Frame-Options): no other site can show these pages, the admin above all, inside
#   a hidden frame to trick clicks
# - the referrer sent to other sites is the site's address only, never the page's full path
# - the content security policy: scripts only from this site (there are no inline scripts), pictures from this site
#   or any https address (shop listings may use one), and the request form may only send to Formspree
# - visitor statistics (Cloudflare Web Analytics, only when a token is set on the admin's Global tab): its beacon
#   script from static.cloudflareinsights.com, reporting to cloudflareinsights.com
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self' https://formspree.io https://cloudflareinsights.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# The admin has its own policy: it also talks to the publisher Worker, and its HEIC converter (heic-to, loaded from
# jsDelivr with an integrity hash, see admin/heic.js) decodes in a worker made from a blob, with WebAssembly whose
# generated glue code uses new Function, so this page alone allows 'unsafe-eval'. Scripts still come only from
# this site and that one CDN.
/admin/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self' https://martin-audio-labs-publisher.thealexandersound.workers.dev https://cdn.jsdelivr.net blob: data:; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# ---- Caching ----------------------------------------------------------------------------------------------------
# Pages (.html), data files and pictures are re-checked with the server every time. The browser still keeps a
# copy and the server answers "unchanged" (304) with no download, so this costs almost nothing, but a picture
# can never be stuck in a visitor's cache: not a stale one, and not a failed request made just before a new
# picture finished deploying. (Long "immutable" caching of pictures was removed for exactly that reason.)
/images/*
  Cache-Control: no-cache

# The stylesheet and scripts keep their names when they change, so they are re-checked every time too. Caching
# them for a few minutes let a visitor get a new page with the previous stylesheet after an update (new parts of
# the page then showed unstyled until that copy expired).
/assets/*
  Cache-Control: no-cache
