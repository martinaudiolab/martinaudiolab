# Cache rules for Cloudflare (not served to visitors). Pages (.html) keep Cloudflare's default:
# the browser re-checks them every time, so a saved change appears straight away.

# Pictures uploaded from the admin get a unique random name, so a given address never changes.
/images/site/*
  Cache-Control: public, max-age=31536000, immutable
/images/shop/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures with fixed names can be replaced, so they are kept for a day.
/images/posts/*
  Cache-Control: public, max-age=86400
/images/banner.jpg
  Cache-Control: public, max-age=86400
/images/category-*
  Cache-Control: public, max-age=86400

# Stylesheet and scripts are not renamed when they change, so keep them briefly.
/assets/*
  Cache-Control: public, max-age=600
